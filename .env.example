# ───────────────────────── Site ─────────────────────────
# Public URL of the deployed site (no trailing slash). Used in emails, Stripe
# redirects, calendar invites and the Recall output-media page.
NEXT_PUBLIC_SITE_URL=https://panther.example
# Comma-separated list of parent emails allowed into /admin.
ADMIN_EMAILS=you@example.com
# Random string; the Netlify scheduled function sends it as a Bearer token to /api/cron/tick.
CRON_SECRET=
# Optional: Plausible domain for privacy-friendly analytics (leave empty to disable).
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ───────────────────────── Supabase ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# "Publishable" (new) or "anon" (legacy) key — safe for the browser, RLS applies.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role (or new "secret") key — server only, bypasses RLS. Never expose.
SUPABASE_SECRET_KEY=
# Optional: Postgres connection string if you apply migrations with psql/the Supabase CLI instead of the SQL editor.
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ───────────────────────── Stripe ─────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ───────────────────────── Google Workspace ─────────────────────────
# Service account JSON (one line) with domain-wide delegation enabled for the scopes:
#   https://www.googleapis.com/auth/meetings.space.created
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_SERVICE_ACCOUNT_JSON=
# The Workspace user the service account acts as (owns the Meet spaces and calendar events).
GOOGLE_IMPERSONATE_USER=sessions@yourdomain.com
# Calendar the invites are created on. "primary" = the impersonated user's calendar.
GOOGLE_CALENDAR_ID=primary

# ───────────────────────── Email (Resend) ─────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Panther <hello@panther.example>"

# ───────────────────────── Alerts (Twilio → you) ─────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
ALERT_PHONE_NUMBER=+1...

# ───────────────────────── Tutor backend ─────────────────────────
# Recall.ai — the note-taking assistant bot that joins the Meet (writes the recap, flags safety issues).
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Workspace verification secret (or legacy Svix endpoint secret) used to verify Recall webhooks/websockets.
RECALL_WEBHOOK_SECRET=whsec_...
# Display name of the assistant bot in the Meet participant list.
RECALL_BOT_NAME=Panther Assistant
# LiveKit — used by /bridge and the assistant agent for low-latency audio.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the assistant agent sends as Bearer token to /api/agent/*.
AGENT_API_KEY=
# Optional: public wss:// URL of the realtime frames relay (realtime/). Leave empty to skip frames.
NEXT_PUBLIC_FRAMES_WS_URL=
# Secret that signs /bridge and frames-relay tokens (also set on the relay). Falls back to AGENT_API_KEY.
FRAMES_WS_SECRET=

# Server-side pepper for hashing emails/phones in trial_claims (random 32+ chars).
HASH_PEPPER=
